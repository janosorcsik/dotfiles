{
    "$schema": "https://opencode.ai/config.json",
    "model": "anthropic/claude-sonnet-4-6",
    "autoupdate": true,
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "write": "allow"
    },
    "compaction": {
        "auto": true
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest"
    ],
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true
        }
    }
}
